@model Azure.AI.TextAnalytics.LinkedEntityCollection

@{
    ViewBag.Title = "Entity Recognition Results";
}

<h2>Recognized Entities</h2>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Text</th>
                <th>URL</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entity in Model)
            {
                <tr>
                    <td>@entity.Name</td>
                    <td><a href="@entity.Url" target="_blank">@entity.Url</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No entities found.</p>
}

