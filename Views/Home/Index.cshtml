@{
    ViewData["Title"] = "Home page text processing";
}

<section style="border: 2px solid #4CAF50; padding: 20px; margin-bottom: 20px;">
    <h2 style="color: #4CAF50;">Text Analysis</h2>
    <p>Enter the text you want to analyze below.</p>
    <form method="post" asp-action="AnalyzeText">
        <label for="textToAnalyze" style="font-weight: bold;">Enter text for analysis:</label><br>
        <textarea id="textToAnalyze" name="userInput" rows="6" cols="50" required style="width: 100%; margin-bottom: 10px;"></textarea><br>
        <button type="submit" style="background-color: #4CAF50; color: white; padding: 10px 20px; border: none; cursor: pointer;">Analyze</button>
    </form>
</section>

<hr style="border: 1px solid #ddd; margin: 30px 0;">

<section style="border: 2px solid #2196F3; padding: 20px;">
    <h2 style="color: #2196F3;">Entity Recognition</h2>
    <p>Enter the text you want to recognize entities in below.</p>
    <form method="post" asp-action="RecognizeEntities">
        <label for="textToRecognize" style="font-weight: bold;">Enter text for entity recognition:</label><br>
        <textarea id="textToRecognize" name="userInput" rows="6" cols="50" required style="width: 100%; margin-bottom: 10px;"></textarea><br>
        <button type="submit" style="background-color: #2196F3; color: white; padding: 10px 20px; border: none; cursor: pointer;">Recognize</button>
    </form>
</section>

<hr style="border: 1px solid #ddd; margin: 30px 0;">

<section style="border: 2px solid #FF9800; padding: 20px;">
    <h2 style="color: #FF9800;">Personal Information Detection</h2>
    <p>Enter the text you want to check for personal information in below.</p>
    <form method="post" asp-action="PersonalDetect">
        <label for="textToRecognize" style="font-weight: bold;">Enter text for checking:</label><br>
        <textarea id="textToRecognize" name="userInput" rows="6" cols="50" required style="width: 100%; margin-bottom: 10px;"></textarea><br>
        <button type="submit" style="background-color: #FF9800; color: white; padding: 10px 20px; border: none; cursor: pointer;">Detect</button>
    </form>
</section>

<hr style="border: 1px solid #ddd; margin: 30px 0;">

<section style="border: 2px solid #F06292; padding: 20px;">
    <h2 style="color: #F06292;">Healthcare Information Detection</h2>
    <p>Enter the text you want to check for healthcare information in below.</p>
    <form method="post" asp-action="HealthcareEntities">
        <label for="textToRecognize" style="font-weight: bold;">Enter text for checking:</label><br>
        <textarea id="textToRecognize" name="userInput" rows="6" cols="50" required style="width: 100%; margin-bottom: 10px;"></textarea><br>
        <button type="submit" style="background-color: #F06292; color: white; padding: 10px 20px; border: none; cursor: pointer;">Detect</button>
    </form>
</section>

<hr style="border: 1px solid #ddd; margin: 30px 0;">

<section style="border: 2px solid #4DB6AC; padding: 20px;">
    <h2 style="color: #4DB6AC;">Text Translation</h2>
    <p>Enter the text you want to translate and choose the target language.</p>
    <form method="post" asp-action="Translate">
        <label for="textToTranslate" style="font-weight: bold;">Enter text for translation:</label><br>
        <textarea id="textToTranslate" name="userInput" rows="6" cols="50" required style="width: 100%; margin-bottom: 10px;"></textarea><br>
        <label for="language" style="font-weight: bold;">Select Target Language:</label><br>
        <select id="language" name="targetLanguage" style="width: 100%; margin-bottom: 10px;" required>
            @foreach (var lang in ViewBag.Languages as List<SelectListItem>)
            {
                <option value="@lang.Value">@lang.Text</option>
            }
        </select><br>
        <button type="submit" style="background-color: #4DB6AC; color: white; padding: 10px 20px; border: none; cursor: pointer;">Translate</button>
    </form>
</section>

<hr style="border: 1px solid #ddd; margin: 30px 0;">

<section style="border: 2px solid #FF7043; padding: 20px;">
    <h2 style="color: #FF7043;">Optical Characters Recognition</h2>
    <p>Upload the image you want to recognize</p>
    <form method="post" asp-action="OpticalCharactersRecognition" enctype="multipart/form-data">
        <label for="image" style="font-weight: bold;">Upload image for recognition:</label><br>
        <input type="file" name="image" accept=".jpg,.jpeg,.png" required /><br /><br />
        <button type="submit" style="background-color: #FF7043; color: white; padding: 10px 20px; border: none; cursor: pointer;">Recognize</button>
    </form>
</section>

<hr style="border: 1px solid #ddd; margin: 30px 0;">

<section style="border: 2px solid #A5D6A7; padding: 20px;">
    <h2 style="color: #A5D6A7;">Image Analysis</h2>
    <p>Upload the image you want to recognize</p>
    <form method="post" asp-action="ImageAnalysis" enctype="multipart/form-data">
        <label for="image" style="font-weight: bold;">Upload image to analys:</label><br>
        <input type="file" name="image" accept=".jpg,.jpeg,.png" required /><br /><br />
        <button type="submit" style="background-color: #A5D6A7; color: white; padding: 10px 20px; border: none; cursor: pointer;">Recognize</button>
    </form>
</section>

<hr style="border: 1px solid #ddd; margin: 30px 0;">

<section style="border: 2px solid #D1C4E9; padding: 20px;">
    <h2 style="color: #D1C4E9;">Face service</h2>
    <p>Upload the image you want to recognize</p>
    <form method="post" asp-action="FaceService" enctype="multipart/form-data">
        <label for="image" style="font-weight: bold;">Upload image for face detection:</label><br>
        <input type="file" name="image" accept=".jpg,.jpeg,.png" required /><br /><br />
        <button type="submit" style="background-color: #D1C4E9; color: white; padding: 10px 20px; border: none; cursor: pointer;">Send</button>
    </form>
</section>

<hr style="border: 1px solid #ddd; margin: 30px 0;">
<section style="border: 2px solid #E9D1C4; padding: 20px;">
    <h2 style="color: #E9D1C4;">Additional task: code recognize</h2>
    <p>Upload the image where you want to extract code</p>
    <form method="post" asp-action="Code" enctype="multipart/form-data">
        <label for="image" style="font-weight: bold;">Upload image for recognition:</label><br>
        <input type="file" name="image" accept=".jpg,.jpeg,.png" required /><br /><br />
        <button type="submit" style="background-color: #E9D1C4; color: white; padding: 10px 20px; border: none; cursor: pointer;">Recognize</button>
    </form>
</section>



<hr style="border: 1px solid #ddd; margin: 30px 0;">


@section Styles {
    <style type="text/css">
        .immersive-reader-button {
            background-color: white;
            margin-top: 5px;
            border: 1px solid black;
            float: right;
        }
    </style>
}

<div class="container">
    <button class="immersive-reader-button" data-button-style="iconAndText" data-locale="en"></button>

    <h1 id="ir-title">About Immersive Reader</h1>
    <div id="ir-content" lang="en-us">
        <p>
            Immersive Reader is a tool that implements proven techniques to improve reading comprehension for emerging readers, language learners, and people with learning differences.
            The Immersive Reader is designed to make reading more accessible for everyone. The Immersive Reader
            <ul>
                <li>
                    Shows content in a minimal reading view
                </li>
                <li>
                    Displays pictures of commonly used words
                </li>
                <li>
                    Highlights nouns, verbs, adjectives, and adverbs
                </li>
                <li>
                    Reads your content out loud to you
                </li>
                <li>
                    Translates your content into another language
                </li>
                <li>
                    Breaks down words into syllables
                </li>
            </ul>
        </p>
        <h3>
            The Immersive Reader is available in many languages.
        </h3>
        <p lang="es-es">
            El Lector inmersivo está disponible en varios idiomas.
        </p>
        <p lang="zh-cn">
            沉浸式阅读器支持许多语言
        </p>
        <p lang="de-de">
            Der plastische Reader ist in vielen Sprachen verfügbar.
        </p>
        <p lang="ar-eg" dir="rtl" style="text-align:right">
            يتوفر \"القارئ الشامل\" في العديد من اللغات.
        </p>
    </div>
</div>


@section Scripts
{
    <script src="https://ircdname.azureedge.net/immersivereadersdk/immersive-reader-sdk.1.4.0.js"></script>
    <script>
        function getTokenAndSubdomainAsync() {
            return new Promise(function (resolve, reject) {
                $.ajax({
                    url: "@Url.Action("GetTokenAndSubdomain", "Home")",
                    type: "GET",
                    success: function (data) {
                        if (data.error) {
                            reject(data.error);
                        } else {
                            resolve(data);
                        }
                    },
                    error: function (err) {
                        reject(err);
                    }
                });
            });
        }

        $(".immersive-reader-button").click(function () {
            handleLaunchImmersiveReader();
        });

        function handleLaunchImmersiveReader() {
            getTokenAndSubdomainAsync()
                .then(function (response) {
                    const token = response["token"];
                    const subdomain = response["subdomain"];

                    // Learn more about chunk usage and supported MIME types https://learn.microsoft.com/azure/ai-services/immersive-reader/reference#chunk
                    const data = {
                        title: $("#ir-title").text(),
                        chunks: [{
                            content: $("#ir-content").html(),
                            mimeType: "text/html"
                        }]
                    };

                    // Learn more about options https://learn.microsoft.com/azure/ai-services/immersive-reader/reference#options
                    const options = {
                        "onExit": exitCallback,
                        "uiZIndex": 2000
                    };

                    ImmersiveReader.launchAsync(token, subdomain, data, options)
                        .catch(function (error) {
                            alert("Error in launching the Immersive Reader. Check the console.");
                            console.log(error);
                        });
                })
                .catch(function (error) {
                    alert("Error in getting the Immersive Reader token and subdomain. Check the console.");
                    console.log(error);
                });
        }

        function exitCallback() {
            console.log("This is the callback function. It is executed when the Immersive Reader closes.");
        }
    </script>
}