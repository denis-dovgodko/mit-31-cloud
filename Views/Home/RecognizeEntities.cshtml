@model Azure.AI.TextAnalytics.CategorizedEntityCollection

@{
    ViewBag.Title = "Entity Recognition Results";
}

<h2>Recognized Entities</h2>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Text</th>
                <th>Category</th>
                <th>SubCategory</th>
                <th>ConfidenceScore:F2</th>
                <th>Length</th>
                <th>Offset</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entity in Model)
            {
                <tr>
                    <td>@entity.Text</td>
                    <td>@entity.Category</td>
                    <td>@(entity.SubCategory ?? "N/A")</td>
                    <td>@entity.ConfidenceScore.ToString("F2")</td>
                    <td>@entity.Length</td>
                    <td>@entity.Offset</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No entities found.</p>
}

